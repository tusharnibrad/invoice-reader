# Any OpenAI-compatible provider works. Pick one and fill in the three values.
# Free tiers change often, so check the provider's current docs for the exact model name.
#
# Example (Google Gemini, OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<a current Gemini Flash model name from Google's docs>
#
# Example (Groq):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=<a current model name from Groq's docs>

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=
